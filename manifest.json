{
  "manifest_version": 3,
  "name": "Flexible UI",
  "version": "3.1.3",
  "description": "Customize YouTube ambient backgrounds, playback, video lists and channel previews with shared site settings.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "96": "assets/icon-96.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Flexible UI — Settings"
  },
  "background": {
    "service_worker": "extension-background.js"
  },
  "minimum_chrome_version": "111",
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "channel-bridge.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings-store.js",
        "lucide-icons.js",
        "site-registry.js",
        "playback-card.js",
        "choice-menu.js",
        "color-picker.js",
        "quick-panel.js",
        "settings-backup.js",
        "settings-dialog.js",
        "media-controller.js",
        "site-appearance.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "ambient.css",
        "watch-sidebar.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings-store.js",
        "lucide-icons.js",
        "site-registry.js",
        "playback-card.js",
        "choice-menu.js",
        "color-picker.js",
        "quick-panel.js",
        "settings-backup.js",
        "settings-dialog.js",
        "media-controller.js",
        "site-appearance.js",
        "black-bar-detector.js",
        "renderer.js",
        "flash-monitor.js",
        "worker-client.js",
        "ambient.js",
        "watch-sidebar.js",
        "channel-card.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "worker-host.html"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "homepage_url": "https://github.com/REZERV-Amaghini/flexible-ui"
}
